NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Used by webhooks to write rows.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

NEXT_PUBLIC_SITE_URL=https://your-domain.example

# NovaPay (M-PESA STK push)
NOVAPAY_APP_KEY=your_novapay_app_key
# Long random string (openssl rand -hex 32). Appended to the callback URL as ?token=
MPESA_CALLBACK_SECRET=

# WhatsApp gateway
WHATSAPP_GATEWAY_API_KEY=your_gateway_api_key
# Long random string. Appended to the webhook URL registered with the gateway.
WHATSAPP_WEBHOOK_SECRET=
